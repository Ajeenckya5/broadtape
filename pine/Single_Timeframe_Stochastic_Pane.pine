//@version=5
// Companion pane for "Single-Timeframe RSI + Stochastic".
// Set Mode to the SAME value as the strategy so Stochastic is never mixed with another TF.
// This script does not trade; it only plots %K / %D from the selected timeframe.

indicator(
     title      = "Single-Timeframe Stochastic",
     shorttitle = "STF Stoch",
     overlay    = false,
     precision  = 2)

string modeInput = input.string(
     "Swing (Hourly)",
     "Mode",
     options = ["Swing (Hourly)", "Intraday (15-min)"],
     group   = "1. Timeframe discipline",
     tooltip = "Must match the strategy Mode. Stochastic is read only from this timeframe.")

int stochLength = input.int(
     14, "Stochastic length", minval = 1, group = "2. Stochastic")
int stochSmoothK = input.int(
     3, "%K smoothing", minval = 1, group = "2. Stochastic")
int stochSmoothD = input.int(
     3, "%D smoothing", minval = 1, group = "2. Stochastic")
int stochOversold = input.int(
     20, "Stochastic oversold", minval = 1, maxval = 50, group = "2. Stochastic")
int stochOverbought = input.int(
     80, "Stochastic overbought", minval = 50, maxval = 99, group = "2. Stochastic")

string signalTf   = modeInput == "Swing (Hourly)" ? "60" : "15"
string tfNiceName = modeInput == "Swing (Hourly)" ? "60 min" : "15 min"
bool   chartFasterThanSignal = timeframe.in_seconds() < timeframe.in_seconds(signalTf)

stfStoch() =>
    float kValue = ta.sma(ta.stoch(close, high, low, stochLength), stochSmoothK)
    float dValue = ta.sma(kValue, stochSmoothD)
    [kValue, dValue]

stfStochClosed() =>
    float kValue = ta.sma(ta.stoch(close, high, low, stochLength), stochSmoothK)
    float dValue = ta.sma(kValue, stochSmoothD)
    [kValue[1], dValue[1]]

[kLive, dLive]     = request.security(syminfo.tickerid, signalTf, stfStoch(),       gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[kClosed, dClosed] = request.security(syminfo.tickerid, signalTf, stfStochClosed(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
float kVal = chartFasterThanSignal ? kClosed : kLive
float dVal = chartFasterThanSignal ? dClosed : dLive

plot(kVal, "%K", color = #26A69A, linewidth = 2)
plot(dVal, "%D", color = #FF9800, linewidth = 1)

obsLine = hline(stochOverbought, "Overbought", color = color.new(#EF5350, 40), linestyle = hline.style_dashed)
ossLine = hline(stochOversold,   "Oversold",   color = color.new(#26A69A, 40), linestyle = hline.style_dashed)
hline(50, "Mid", color = color.new(#787B86, 50), linestyle = hline.style_dotted)
topLine = hline(100, "Top", color = color.new(#EF5350, 100))
botLine = hline(0,   "Bot", color = color.new(#26A69A, 100))
fill(obsLine, topLine, color = color.new(#EF5350, 88), title = "Overbought zone")
fill(ossLine, botLine, color = color.new(#26A69A, 88), title = "Oversold zone")

bgcolor(kVal < stochOversold and dVal < stochOversold ? color.new(#26A69A, 90) : kVal > stochOverbought and dVal > stochOverbought ? color.new(#EF5350, 90) : na, title = "Stoch zone")

var table hdr = table.new(position.top_left, 1, 1, bgcolor = color.new(#131722, 20), frame_color = #2A2E39, frame_width = 1)
if barstate.islast
    table.cell(hdr, 0, 0, modeInput + "  |  Stoch  |  " + tfNiceName, text_color = #D1D4DC, text_size = size.small)
